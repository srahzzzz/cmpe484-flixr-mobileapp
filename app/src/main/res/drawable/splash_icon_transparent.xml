<?xml version="1.0" encoding="utf-8"?>
<!--
  Transparent splash icon for Android 12+.

  Android 12+ always shows a centered "splash icon" with a mask (often looks like a circle).
  The user wants a full-screen image only, so we make the system icon invisible and show the
  full-screen image inside Compose immediately after launch.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <size android:width="1dp" android:height="1dp" />
    <solid android:color="@android:color/transparent" />
</shape>

