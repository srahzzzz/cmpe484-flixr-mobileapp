<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Flixr.Launch" parent="Theme.Flixr">
        <!-- Android 12+ SplashScreen integration -->
        <!-- Background behind the splash icon -->
        <item name="android:windowSplashScreenBackground">@color/flixr_deep_blue</item>

        <!-- Hide the system-centered splash icon (avoids the circle). -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>

        <!-- Pre-Android 12 fallback (harmless on 12+) -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

</resources>

