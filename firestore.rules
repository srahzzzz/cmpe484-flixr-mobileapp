rules_version = '2';

// Deploy: `firebase deploy --only firestore:rules` (requires Firebase CLI & project).
// Tune for production: tighten `Reviews` reads, add Storage rules for profile pictures.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // --- Profiles ---
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Username locks: email signup reserves BEFORE auth exists (see app AuthRepository).
    match /usernames/{name} {
      allow read: if signedIn();
      // Pre-auth reservation step uses uid "__RESERVED__".
      allow create: if
        (resource == null && request.resource.data.uid == '__RESERVED__') ||
        (signedIn() && request.resource.data.uid == request.auth.uid);
      allow update: if
        (signedIn() && resource.data.uid == '__RESERVED__' && request.resource.data.uid == request.auth.uid) ||
        (signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // --- Reviews (public read for movie pages; writes scoped) ---
    match /Reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.review_id == reviewId;
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
      // Owner edits full doc OR any signed-in user only bumps likes_count (see LikeRepository).
      allow update: if signedIn() && (
        resource.data.user_id == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes_count'])
      );
    }

    match /Watchlist/{docId} {
      allow read, delete: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.user_id == request.auth.uid;
    }

    match /WatchHistory/{docId} {
      allow read, delete: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.user_id == request.auth.uid;
    }

    match /Followers/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.follower_id == request.auth.uid;
      allow delete: if signedIn() && resource.data.follower_id == request.auth.uid;
      allow update: if false;
    }

    match /Likes/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
